{
  "name": "detailing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:db": "tsx scripts/db/dev.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env db/seed.ts --reset",
    "admin:create": "tsx --env-file-if-exists=.env scripts/admin-create.ts",
    "email:preview": "email dev --dir emails",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:stripe": "playwright test --grep @stripe-live",
    "site-checks": "playwright test --project=site-checks",
    "lhci": "lhci autorun",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "launch-check": "tsx --env-file-if-exists=.env scripts/launch-check.ts",
    "verify:report": "tsx scripts/verification-report.ts",
    "model:optimize": "tsx scripts/optimize-model.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@dnd-kit/core": "^6.3.1",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "better-auth": "~1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "~0.45.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.57.0",
    "next": "~16.4.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "~19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "~19.3.1",
    "react-email": "^6.11.2",
    "react-hook-form": "^7.90.0",
    "resend": "^6.33.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "temporal-polyfill": "^1.0.6",
    "three": "~0.186.1",
    "twilio": "^6.2.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "~0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "~0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-config-next": "~16.4.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
