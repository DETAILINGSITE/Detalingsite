# Copy to .env and fill in. Every variable is documented in docs/PLAN.md §8, including
# what happens when it's missing. NEVER commit .env.

# ── Core ─────────────────────────────────────────────────────────────────────
# Local: `pnpm dev:db` prints this URL (embedded Postgres 18 on port 54329).
DATABASE_URL=postgres://detailing:detailing-local-only@127.0.0.1:54329/detailing
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random characters; signs customer booking/quote links. Rotating it invalidates existing links.
TOKEN_PEPPER=
# Optional: hostname of public admin-uploaded media (R2 public bucket / custom domain)
NEXT_PUBLIC_MEDIA_HOST=

# ── Admin auth (Better Auth) ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Dev convenience only: set to 1 to skip the owner 2FA requirement locally.
ADMIN_2FA_OPTIONAL=

# ── Stripe (deposits) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="MJDETAILZ <bookings@yourdomain.com>"
OWNER_NOTIFY_EMAIL=

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
OWNER_NOTIFY_PHONE=

# ── Bot protection (Cloudflare Turnstile) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google Maps Platform ─────────────────────────────────────────────────────
# Server key: Places API (New) + Geocoding, restricted by IP.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Maps Embed API only, restricted by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ── Photo uploads (Cloudflare R2 / any S3-compatible) ────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Optional ad/analytics tags — loading any of these turns on the consent banner.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GADS_ID=

# ── Google Calendar sync (also set business.flags.googleCalendarSync = true) ──
GCAL_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GCAL_CALENDAR_ID=

# ── Test-only drivers (refused in production) ────────────────────────────────
# PAYMENTS_DRIVER=fake
# NOTIFY_DRIVER=capture
# STORAGE_DRIVER=local
# CAPTCHA_DRIVER=test
# TEST_CLOCK=1
# E2E_TEST_MODE=1
# SHOP_ENABLED=1   # in-shop bookings (MJDETAILZ is mobile-only; the e2e suite turns this on)
PAYMENTS_DRIVER=
NOTIFY_DRIVER=
STORAGE_DRIVER=
CAPTCHA_DRIVER=
TEST_CLOCK=
E2E_TEST_MODE=
# Shareable demo of a test-mode build: keeps fake payments, disables the other test controls.
PREVIEW_MODE=
VERCEL_ENV=
